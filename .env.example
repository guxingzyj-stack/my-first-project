# SiliconCloud API 配置
SILICONCLOUD_API_KEY=你的SiliconCloud_API_Key

# SiliconCloud API 地址（默认不需要修改）
SILICONCLOUD_BASE_URL=https://api.siliconflow.cn/v1

# Embedding 模型（默认不需要修改）
EMBEDDING_MODEL=BAAI/bge-m3

# Qdrant Cloud 配置
# 从 Zeabur 环境变量中获取这些值
QDRANT_URL=https://你的集群ID.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=你的Qdrant_API_Key_或_JWT_Token
